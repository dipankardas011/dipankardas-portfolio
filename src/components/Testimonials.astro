---
import SectionHeader from "./SectionHeader.astro";
import type { Testimonial } from "../data/testimonials";

interface Props {
  testimonials: Testimonial[];
  index?: number;
}

const { testimonials, index } = Astro.props;

/** Split stored content into paragraphs for editorial layout.
 * Long recommendations are excerpted to the first two paragraphs —
 * the full text lives on LinkedIn, linked in the attribution. */
const MAX_PARAGRAPHS = 2;
const entries = testimonials.map((t) => {
  const paragraphs = t.content.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
  return {
    ...t,
    paragraphs: paragraphs.slice(0, MAX_PARAGRAPHS),
    excerpted: paragraphs.length > MAX_PARAGRAPHS,
  };
});
---

<section class="py-20 lg:py-28 border-t border-app-ink-line">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 lg:mb-16">
      <div class="lg:col-span-6">
        <SectionHeader
          title="Testimonials"
          kicker="signed · in the margins"
          index={index}
          className="mb-0"
        />
      </div>
      <div class="lg:col-span-6 lg:pt-12" data-reveal>
        <p class="text-base lg:text-lg leading-[1.55] text-app-gray-500 max-w-xl">
          What people I've worked with have to say about my work and contributions to their projects.
        </p>
      </div>
    </div>

    <div class="flex flex-col">
      {entries.map((item, i) => (
        <figure
          class:list={[
            "py-12 lg:py-16 border-t border-app-border first:border-t-0 grid grid-cols-1 lg:grid-cols-12 gap-8",
          ]}
          data-reveal
        >
          <blockquote
            class:list={[
              "pullquote lg:col-span-8",
              i % 2 === 1 && "lg:col-start-5",
            ]}
          >
            <div class:list={["pullquote-body", item.content.length > 600 && "pullquote-body--long"]}>
              {item.paragraphs.map((p) => <p>{p}</p>)}
              {item.excerpted && item.linkedinUrl && (
                <p class="font-serif italic text-[0.8em] text-app-gray-400">
                  — excerpted ·{" "}
                  <a
                    href={item.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-app-accent-2 hover:text-app-accent transition-colors"
                  >full recommendation on LinkedIn ↗</a>
                </p>
              )}
            </div>
          </blockquote>

          <figcaption
            class:list={[
              "lg:col-span-4 flex lg:flex-col items-center lg:items-start gap-4 lg:justify-end",
              i % 2 === 1 ? "lg:col-start-1 lg:row-start-1 lg:items-end lg:text-right" : "lg:pl-8",
            ]}
          >
            <img
              src={item.photo}
              alt={item.name}
              class="w-12 h-12 lg:w-14 lg:h-14 object-cover border border-app-ink-line grayscale"
              loading="lazy"
            />
            <div class:list={["min-w-0", i % 2 === 1 && "lg:text-right"]}>
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-app-text font-semibold">
                {item.name}
              </p>
              {item.role && item.company && (
                <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-app-gray-400 leading-[1.6]">
                  {item.role} · {item.company}
                </p>
              )}
              {item.linkedinUrl && (
                <a
                  href={item.linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-app-accent-2 hover:text-app-accent transition-colors"
                  aria-label={`View ${item.name}'s LinkedIn recommendation`}
                >
                  linkedin ↗
                </a>
              )}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
