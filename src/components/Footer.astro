---
import { socialLinks, siteConfig } from "../data/site";

const year = new Date().getFullYear();

const socials = [
  { label: "GitHub",   href: socialLinks.github },
  { label: "Twitter",  href: socialLinks.twitter },
  { label: "GitLab",   href: socialLinks.gitlab },
  { label: "LinkedIn", href: socialLinks.linkedin },
  { label: "Upwork",   href: socialLinks.upwork },
  { label: "Fiverr",   href: socialLinks.fiverr },
];
---

<footer class="ink-section mt-20 lg:mt-28 border-t border-app-ink-line">
  <div class="container mx-auto py-16 lg:py-20">

    <!-- CTA block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-12 lg:pb-16 border-b border-app-ink-border">
      <div class="lg:col-span-7">
        <p class="kicker mb-5">/contact · open to work</p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-app-on-ink leading-[0.95] tracking-tight">
          Let's build the<br/>
          <span class="font-serif italic font-normal text-app-accent">infrastructure</span>
          your team deserves.
        </h2>
      </div>
      <div class="lg:col-span-5 flex flex-col justify-end gap-3">
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center justify-between gap-2 w-full lg:max-w-md px-6 py-3 rounded-full bg-app-body text-app-ink border border-app-body font-mono text-[11px] uppercase tracking-[0.12em] font-semibold hover:bg-app-accent hover:border-app-accent hover:text-app-ink transition-colors duration-300"
        >
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>{siteConfig.email}</span>
          </span>
          <span>→</span>
        </a>
        <a
          href={socialLinks.linkedin}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-between gap-2 w-full lg:max-w-md px-6 py-3 rounded-full border border-app-ink-border text-app-on-ink font-mono text-[11px] uppercase tracking-[0.12em] font-medium hover:border-app-body transition-colors duration-300"
        >
          <span>Connect on LinkedIn</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Socials grid -->
    <div class="mt-12 lg:mt-14 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-px bg-app-ink-border border border-app-ink-border">
      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          class="group bg-app-ink hover:bg-app-body hover:text-app-ink text-app-on-ink transition-colors duration-300 px-5 py-5 flex flex-col justify-between min-h-[88px]"
        >
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-app-accent">
            ↗
          </span>
          <span class="font-display text-base font-medium tracking-tight">{s.label}</span>
        </a>
      ))}
    </div>

    <!-- Sign-off -->
    <div class="pt-14 lg:pt-16 flex items-end justify-between gap-6">
      <p class="font-serif italic text-[clamp(2rem,5vw,3.75rem)] leading-[1.05] text-app-on-ink tracking-[-0.01em]">
        — <span class="text-app-accent">{siteConfig.name}</span>
      </p>
      <span class="hidden sm:block font-mono text-[10px] uppercase tracking-[0.18em] text-app-on-ink-muted pb-2">
        fin.
      </span>
    </div>

    <!-- Bottom row -->
    <div class="mt-10 pt-6 border-t border-app-ink-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-app-on-ink-muted">
      <span>&copy; {year} · {siteConfig.name}</span>
      <span>built with astro · hosted with care</span>
      <a href="/rss.xml" class="hover:text-app-on-ink transition-colors">RSS</a>
    </div>
  </div>
</footer>
