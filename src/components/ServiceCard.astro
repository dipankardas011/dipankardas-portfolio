---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  abbreviation?: string;
  icon: string;
  description: string;
  skills: string[];
  /** kept for API compatibility — the editorial system uses a single ink/terracotta treatment */
  color?: string;
  index?: number;
}

const { title, abbreviation, icon, description, skills, index } = Astro.props;
---

<article class="group relative h-full flex flex-col bg-app-body border border-app-border p-6 lg:p-7 card-hover overflow-hidden">
  <!-- Top edge accent -->
  <span class="absolute top-0 left-0 right-0 h-px bg-app-ink-line"></span>
  <span class="absolute top-0 left-0 h-[2px] bg-app-accent w-0 group-hover:w-full transition-[width] duration-500"></span>

  <div class="flex items-start justify-between mb-6">
    <div class="w-12 h-12 lg:w-14 lg:h-14 flex items-center justify-center border border-app-ink-line bg-app-body relative">
      <Icon name={icon} class="w-6 h-6 lg:w-7 lg:h-7 text-app-accent-2" />
      <span class="absolute -bottom-px -right-px w-2.5 h-2.5 border-r border-b border-app-accent-2"></span>
    </div>
    <div class="flex items-baseline gap-2 font-mono text-[10px] uppercase tracking-[0.18em]">
      {index !== undefined && (
        <span class="text-app-accent-2 font-semibold">{String(index).padStart(2, "0")}</span>
      )}
      {abbreviation && <span class="text-app-gray-400">/ {abbreviation}</span>}
    </div>
  </div>

  <h3 class="font-display text-xl lg:text-2xl text-app-text tracking-tight leading-[1.15] mb-3">
    {title}
  </h3>
  <p class="text-sm lg:text-[15px] text-app-gray-500 leading-[1.55] mb-6">
    {description}
  </p>

  <div class="mt-auto pt-5 border-t border-app-border">
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-app-gray-400 mb-3">Stack</p>
    <ul class="flex flex-wrap gap-1.5">
      {skills.map((s) => (
        <li class="tag-chip">{s}</li>
      ))}
    </ul>
  </div>
</article>
