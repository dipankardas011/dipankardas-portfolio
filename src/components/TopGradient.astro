---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div
  class={`absolute -top-12 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[260px] h-[260px] md:w-[480px] md:h-[480px] opacity-50 pointer-events-none ${className}`}
  style="background: repeating-linear-gradient(90deg, transparent 0 15px, color-mix(in srgb, var(--color-app-accent) 18%, transparent) 15px 16px); mask-image: radial-gradient(circle, black 0%, transparent 68%);"
  aria-hidden="true"
></div>
