---
import { navItems, siteConfig, socialLinks } from "../data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header id="top" class="site-header">
  <div class="container mx-auto">
    <nav class="nav-console" aria-label="Primary navigation">
      <a href="/" class="wordmark" aria-label={`${siteConfig.name}, home`}>
        <span class="wordmark-code">DD / 011</span>
        <span class="wordmark-name">{siteConfig.name}</span>
        <span class="wordmark-role">PLATFORM ENGINEER</span>
      </a>

      <ol class="desktop-nav">
        {navItems.map((item, index) => (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? "page" : undefined}>
              <span>{String(index + 1).padStart(2, "0")}</span>{item.label}
            </a>
          </li>
        ))}
      </ol>

      <a href={socialLinks.sponsor} target="_blank" rel="noopener noreferrer" class="support-link">
        SUPPORT FIELDWORK <span>↗</span>
      </a>

      <button id="mobile-menu-btn" class="menu-trigger" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">
        <span>MENU</span><i></i><i></i>
      </button>
    </nav>
  </div>

  <div id="mobile-nav" class="mobile-navigation" hidden>
    <div class="mobile-panel">
      <div class="mobile-status"><span>NAVIGATION / MANIFEST</span><span>06 ROUTES</span></div>
      <ol>
        {navItems.map((item, index) => (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? "page" : undefined}>
              <span>{String(index + 1).padStart(2, "0")}</span><strong>{item.label}</strong><b>↗</b>
            </a>
          </li>
        ))}
      </ol>
      <a href={socialLinks.sponsor} target="_blank" rel="noopener noreferrer" class="mobile-support">SPONSOR / GITHUB <span>↗</span></a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-btn");
  const navigation = document.getElementById("mobile-nav");

  function closeMenu() {
    if (!(navigation instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    navigation.hidden = true;
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-label", "Open navigation");
    button.classList.remove("is-open");
    document.body.style.overflow = "";
  }

  button?.addEventListener("click", () => {
    if (!(navigation instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    const opening = navigation.hidden;
    navigation.hidden = !opening;
    button.setAttribute("aria-expanded", String(opening));
    button.setAttribute("aria-label", opening ? "Close navigation" : "Open navigation");
    button.classList.toggle("is-open", opening);
    document.body.style.overflow = opening ? "hidden" : "";
  });

  navigation?.addEventListener("click", (event) => {
    if (event.target === navigation) closeMenu();
  });
  window.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
</script>

<style>
  .site-header { position: relative; z-index: 50; }
  .nav-console { display: grid; grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr); align-items: stretch; min-height: 5.25rem; border-bottom: 1px solid var(--color-app-ink-line); }
  .wordmark { display: grid; grid-template-columns: auto 1fr; gap: .35rem .75rem; align-content: center; padding-right: 1rem; }
  .wordmark-code { grid-row: 1 / 3; align-self: center; display: grid; place-items: center; width: 2.8rem; height: 2.8rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .58rem/1 var(--font-mono); }
  .wordmark-name { align-self: end; font: 620 .92rem/1 var(--font-display); letter-spacing: -.025em; }
  .wordmark-role { align-self: start; color: var(--color-app-gray-400); font: .52rem/1 var(--font-mono); letter-spacing: .1em; }
  .desktop-nav { display: flex; border-inline: 1px solid var(--color-app-border); }
  .desktop-nav li { display: flex; border-right: 1px solid var(--color-app-border); }
  .desktop-nav li:last-child { border-right: 0; }
  .desktop-nav a { position: relative; display: flex; align-items: center; gap: .45rem; padding: 0 clamp(.65rem, 1.2vw, 1.25rem); color: var(--color-app-gray-400); font: .58rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; transition: color .2s, background .2s; }
  .desktop-nav a span { color: var(--color-app-gray-300); font-size: .48rem; }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--color-app-text); background: var(--color-app-surface); }
  .desktop-nav a.active::after { content: ""; position: absolute; right: 0; bottom: -1px; left: 0; height: 3px; background: var(--color-app-accent); }
  .desktop-nav a.active span { color: var(--color-app-accent); }
  .support-link { align-self: center; justify-self: end; display: flex; justify-content: space-between; gap: 1.5rem; min-width: 10.5rem; padding: .75rem .85rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); border: 1px solid var(--color-app-accent); font: .56rem/1 var(--font-mono); letter-spacing: .08em; transition: color .2s, background .2s; }
  .support-link:hover { color: var(--color-app-accent); background: transparent; }
  .menu-trigger { display: none; }
  .mobile-navigation[hidden] { display: none; }

  @media (max-width: 1050px) {
    .nav-console { grid-template-columns: 1fr auto; }
    .desktop-nav, .support-link { display: none; }
    .menu-trigger { align-self: center; display: grid; grid-template-columns: auto 1.3rem; gap: .25rem .7rem; align-items: center; padding: .75rem; color: var(--color-app-text); border: 1px solid var(--color-app-border); font: .58rem/1 var(--font-mono); letter-spacing: .1em; }
    .menu-trigger span { grid-row: 1 / 3; }
    .menu-trigger i { width: 1.3rem; height: 1px; background: currentColor; transition: transform .2s; }
    .menu-trigger.is-open { color: var(--color-app-accent-ink); background: var(--color-app-accent); border-color: var(--color-app-accent); }
    .menu-trigger.is-open i:first-of-type { transform: translateY(.16rem) rotate(45deg); }
    .menu-trigger.is-open i:last-of-type { transform: translateY(-.16rem) rotate(-45deg); }
    .mobile-navigation { position: fixed; z-index: -1; inset: 0; padding-top: 5.25rem; background: color-mix(in srgb, var(--color-app-body) 92%, transparent); backdrop-filter: blur(10px); }
    .mobile-panel { height: calc(100svh - 5.25rem); overflow-y: auto; padding: 1rem max(1rem, calc((100vw - 80rem) / 2)); background: var(--color-app-body); border-top: 1px solid var(--color-app-ink-line); }
    .mobile-status { display: flex; justify-content: space-between; padding: .8rem 0 1.2rem; color: var(--color-app-gray-400); font: .55rem/1 var(--font-mono); letter-spacing: .12em; }
    .mobile-panel ol { border-top: 2px solid var(--color-app-text); }
    .mobile-panel li a { display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: baseline; gap: 1rem; padding: 1.2rem .25rem; border-bottom: 1px solid var(--color-app-border); }
    .mobile-panel li a > span { color: var(--color-app-accent); font: .58rem/1 var(--font-mono); }
    .mobile-panel li strong { font: 650 clamp(1.8rem, 8vw, 3.5rem)/1 var(--font-display); letter-spacing: -.04em; }
    .mobile-panel li b { color: var(--color-app-gray-400); font-weight: 400; }
    .mobile-panel li a.active strong, .mobile-panel li a:hover strong { color: var(--color-app-accent); }
    .mobile-support { display: flex; justify-content: space-between; margin-top: 2rem; padding: 1rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .62rem/1 var(--font-mono); letter-spacing: .1em; }
  }

  @media (max-width: 480px) {
    .wordmark-role { display: none; }
    .wordmark-name { align-self: center; }
  }
</style>
