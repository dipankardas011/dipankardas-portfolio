---
import BaseLayout from "../components/BaseLayout.astro";

const routes = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: "Skills", href: "/skills/" },
  { label: "Projects", href: "/projects/" },
  { label: "Services", href: "/services/" },
  { label: "About", href: "/about/" },
];
---

<BaseLayout title="404 — Page Not Found" noindex={true} bodyClass="error-field-manual">
  <div>
    <section class="error-shell">
      <div class="container mx-auto">
        <div class="status-line reveal" style="--delay: 0">
          <span>INCIDENT REPORT / 0X194</span>
          <span class="fault"><i></i> STATUS / NOT_FOUND</span>
          <span>RETRY / MANUAL</span>
        </div>

        <div class="error-grid">
          <div class="error-code" aria-hidden="true">
            <span class="reveal" style="--delay: 1">4</span>
            <span class="signal reveal" style="--delay: 2">0</span>
            <span class="reveal" style="--delay: 3">4</span>
            <i class="reveal" style="--delay: 4">.</i>
          </div>

          <div class="error-copy reveal" style="--delay: 5">
            <span class="eyebrow">/error · stack underflow</span>
            <h1>This page is<br /><i>not in the index.</i></h1>
            <p>Either the URL is wrong, the page moved, or it never existed. No backtrace to follow — just turn back.</p>
            <div class="actions">
              <a href="/" class="signal-button">Back to home <span>←</span></a>
              <a href="/blog/" class="text-link">Read the blog <span>↘</span></a>
            </div>
          </div>

          <aside class="diagnostic reveal" style="--delay: 6" aria-label="Error diagnostic">
            <div><span>DIAGNOSTIC TRACE</span><span>FAILED</span></div>
            <dl>
              <div><dt>REQUEST</dt><dd>UNRESOLVED</dd></div>
              <div><dt>ROUTE</dt><dd>ABSENT</dd></div>
              <div><dt>BACKTRACE</dt><dd>EMPTY</dd></div>
              <div><dt>NEXT ACTION</dt><dd>REINDEX</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <nav class="route-section" aria-labelledby="route-heading">
      <div class="container mx-auto route-grid">
        <header>
          <span>02 / RECOVERY MAP</span>
          <h2 id="route-heading">Known<br /><i>routes.</i></h2>
          <p>Try one of these indexed locations.</p>
        </header>
        <ol>
          {routes.map((route, index) => (
            <li>
              <a href={route.href}>
                <span>/{String(index + 1).padStart(2, "0")}</span>
                <strong>{route.label}</strong>
                <span>↗</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
  :global(.error-field-manual footer.mt-16) { margin-top: 0; }
  .error-shell { padding-top: 1.25rem; }
  .status-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .7rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .62rem/1 var(--font-mono); letter-spacing: .12em; }
  .status-line span:last-child { text-align: right; }
  .fault { color: var(--color-app-accent); }
  .fault i { display: inline-block; width: .45rem; height: .45rem; margin-right: .5rem; background: var(--color-app-accent); animation: pulse 1.5s infinite; }
  .error-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(16rem, .65fr); border-inline: 1px solid var(--color-app-ink-line); border-bottom: 1px solid var(--color-app-ink-line); }
  .error-code { display: flex; align-items: center; grid-column: 1 / -1; min-width: 0; overflow: hidden; padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 3rem) 0; border-bottom: 1px solid var(--color-app-ink-line); font: 780 clamp(9rem, 27vw, 28rem)/.62 var(--font-display); letter-spacing: -.09em; }
  .error-code span { display: block; }
  .error-code .signal, .error-code i { color: var(--color-app-accent); }
  .error-code i { align-self: flex-end; padding-bottom: .02em; font-family: var(--font-serif); font-weight: 400; }
  .error-copy { padding: clamp(2.5rem, 6vw, 6rem); border-right: 1px solid var(--color-app-ink-line); }
  .eyebrow { color: var(--color-app-accent); font: .65rem/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
  .eyebrow::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  h1 { margin: 2rem 0 1.5rem; font: 650 clamp(2.7rem, 6vw, 6rem)/.88 var(--font-display); letter-spacing: -.055em; }
  h1 i, .route-section h2 i { color: var(--color-app-accent); font-family: var(--font-serif); font-weight: 400; }
  .error-copy > p { max-width: 35rem; color: var(--color-app-gray-500); font-size: .95rem; line-height: 1.6; }
  .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.2rem; }
  .signal-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 13rem; padding: .9rem 1rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); border: 1px solid var(--color-app-accent); font: .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; transition: color .2s, background .2s, transform .2s; }
  .signal-button:hover { color: var(--color-app-accent); background: transparent; transform: translateY(-2px); }
  .text-link { display: inline-flex; gap: 1.2rem; padding-bottom: .35rem; border-bottom: 1px solid currentColor; font: .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .text-link span { color: var(--color-app-accent); }
  .diagnostic { display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; background: var(--color-app-surface); }
  .diagnostic > div { display: flex; justify-content: space-between; color: var(--color-app-gray-400); font: .56rem/1 var(--font-mono); letter-spacing: .1em; }
  .diagnostic > div span:last-child { color: var(--color-app-accent); }
  .diagnostic dl { border-top: 2px solid var(--color-app-text); }
  .diagnostic dl > div { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: 1.1rem .25rem; border-bottom: 1px solid var(--color-app-border); font: .58rem/1 var(--font-mono); letter-spacing: .07em; }
  .diagnostic dt { color: var(--color-app-gray-400); }
  .diagnostic dd { color: var(--color-app-text); }
  .route-section { padding: clamp(5rem, 9vw, 8rem) 0; color: var(--color-app-inverse-text); background: var(--color-app-inverse); }
  .route-grid { display: grid; grid-template-columns: .7fr 1.5fr; gap: clamp(3rem, 9vw, 9rem); }
  .route-section header > span { color: var(--color-app-inverse-accent); font: .62rem/1 var(--font-mono); letter-spacing: .12em; }
  .route-section h2 { margin: 2.5rem 0 1.2rem; font: 650 clamp(3rem, 6vw, 6rem)/.85 var(--font-display); letter-spacing: -.06em; }
  .route-section h2 i { color: var(--color-app-inverse-accent); }
  .route-section header p { color: var(--color-app-inverse-muted); font-size: .86rem; }
  .route-section ol { border-top: 2px solid var(--color-app-inverse-text); }
  .route-section a { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; padding: 1.25rem .25rem; border-bottom: 1px solid var(--color-app-inverse-line); transition: padding .2s, background .2s; }
  .route-section a:hover { padding-inline: .8rem; background: color-mix(in srgb, var(--color-app-inverse-text) 6%, var(--color-app-inverse)); }
  .route-section a span { color: var(--color-app-inverse-accent); font: .58rem/1 var(--font-mono); }
  .route-section a strong { font: 580 clamp(1.35rem, 2.8vw, 2.5rem)/1 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; }
  .reveal { opacity: 0; animation: reveal .75s cubic-bezier(.16,1,.3,1) forwards; animation-delay: calc(var(--delay) * 90ms + 100ms); }
  @keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes pulse { 50% { opacity: .35; } }
  @media (max-width: 900px) {
    .error-grid { grid-template-columns: 1fr; }
    .error-copy { border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .diagnostic { min-height: 24rem; }
  }
  @media (max-width: 640px) {
    .status-line { grid-template-columns: 1fr auto; }
    .status-line span:last-child { display: none; }
    .error-code { font-size: clamp(8rem, 38vw, 13rem); }
    .error-copy { padding: 3rem 1rem; }
    .actions { align-items: flex-start; flex-direction: column; }
    .route-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; animation: none; } .fault i { animation: none; } }
</style>
