---
import BaseLayout from "../../components/BaseLayout.astro";
import { projects, ossContributions, categories } from "../../data/projects";

const projectCategories = [
  ...categories,
  ...projects.map((project) => project.category).filter((category) => !categories.includes(category)),
];
const mergedPrCount = ossContributions.reduce((total, contribution) => total + contribution.prs.length, 0);
---

<BaseLayout
  title="Projects - Dipankar Das"
  description="Open-source projects, distributed systems, and infrastructure tools."
  bodyClass="projects-field-manual"
>
  <div>
    <section class="projects-hero">
      <div class="container mx-auto">
        <div class="status-line reveal" style="--delay: 0">
          <span>DEPLOYMENT REGISTER / PUBLIC</span>
          <span>{projects.length} ENTRIES / {projectCategories.length} CATEGORIES</span>
          <span>{ossContributions.length} OSS ORGS / {mergedPrCount}+ MERGED</span>
        </div>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow reveal" style="--delay: 1">/projects · things i've shipped</p>
            <h1 aria-label="Shipped and broken">
              <span class="reveal" style="--delay: 2">SHIPPED &amp;</span>
              <span class="shift reveal" style="--delay: 3"><i>BROKEN.</i></span>
            </h1>
            <div class="hero-intro reveal" style="--delay: 5">
              <span>01 / REGISTER</span>
              <div>
                <h2>Things I've shipped &amp; broken <i>in production.</i></h2>
                <p>Tools, systems, and experiments built to solve real-world infrastructure problems — not portfolio pieces. Every one of these has shipped or been used in anger.</p>
              </div>
            </div>
          </div>

          <aside class="ledger-summary reveal" style="--delay: 4">
            <div><span>REGISTER TOTALS</span><span>LIVE INDEX</span></div>
            <dl>
              <div><dt>PROJECTS</dt><dd>{String(projects.length).padStart(2, "0")}</dd></div>
              <div><dt>CATEGORIES</dt><dd>{String(projectCategories.length).padStart(2, "0")}</dd></div>
              <div><dt>OSS ORGS</dt><dd>{String(ossContributions.length).padStart(2, "0")}</dd></div>
              <div><dt>PRS MERGED</dt><dd>{mergedPrCount}+</dd></div>
            </dl>
            <p>STATUS / SHIPPED<br />EVIDENCE / LINKED<br />ORDER / BY DOMAIN</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="project-register">
      <div class="container mx-auto">
        {projectCategories.map((category, categoryIndex) => {
          const categoryProjects = projects.filter((project) => project.category === category);
          if (categoryProjects.length === 0) return null;
          return (
            <section class="category-section" aria-labelledby={`category-${categoryIndex}`}>
              <header class="category-heading">
                <div><span class="section-index">{String(categoryIndex + 2).padStart(2, "0")}</span><span class="section-label">CATEGORY / {String(categoryProjects.length).padStart(2, "0")} ENTRIES</span></div>
                <h2 id={`category-${categoryIndex}`}>{category}</h2>
              </header>

              <ol class="project-ledger">
                {categoryProjects.map((project, projectIndex) => (
                  <li>
                    <article>
                      <div class="project-index">
                        <span>P{String(projectIndex + 1).padStart(2, "0")}</span>
                        <span>{project.featured ? "FEATURED" : "ARCHIVE"}</span>
                      </div>
                      <div class="project-main">
                        <h3>{project.title}</h3>
                        <p>{project.description}</p>
                        <ul aria-label={`${project.title} technologies`}>
                          {project.tags.map((tag) => <li>{tag}</li>)}
                        </ul>
                      </div>
                      {project.image ? (
                        <figure><img src={project.image} alt="" loading="lazy" /></figure>
                      ) : (
                        <div class="no-figure" aria-hidden="true"><span>NO / VISUAL</span><strong>{String(categoryIndex + 1).padStart(2, "0")}.{String(projectIndex + 1).padStart(2, "0")}</strong></div>
                      )}
                      <div class="project-links">
                        <span>EXTERNAL / {String(project.links.length).padStart(2, "0")}</span>
                        {project.links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label} ↗</a>)}
                      </div>
                    </article>
                  </li>
                ))}
              </ol>
            </section>
          );
        })}
      </div>
    </section>

    <section class="oss-section">
      <div class="container mx-auto">
        <header class="oss-heading">
          <div><span class="section-index">{String(projectCategories.length + 2).padStart(2, "0")}</span><span class="section-label">UPSTREAM / OSS</span></div>
          <h2>Open source<br /><i>contributions.</i></h2>
          <p>Pull requests merged into CNCF and other community projects.</p>
        </header>

        <ol class="oss-ledger">
          {ossContributions.map((contribution, index) => (
            <li>
              <article>
                <header>
                  <span>ORG / {String(index + 1).padStart(2, "0")}</span>
                  <h3>{contribution.org}</h3>
                  <strong>{String(contribution.prs.length).padStart(2, "0")} PR{contribution.prs.length !== 1 ? "S" : ""}</strong>
                </header>
                <ol>
                  {contribution.prs.map((pr, prIndex) => (
                    <li><a href={pr.url} target="_blank" rel="noopener noreferrer"><span>.{String(prIndex + 1).padStart(2, "0")}</span><span>{pr.title}</span><span>↗</span></a></li>
                  ))}
                </ol>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.projects-field-manual footer.mt-16) { margin-top: 0; }
  .projects-hero { padding-top: 1.25rem; }
  .status-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .7rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .62rem/1 var(--font-mono); letter-spacing: .12em; }
  .status-line span:nth-child(2) { color: var(--color-app-accent); }
  .status-line span:last-child { text-align: right; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(18rem, .55fr); min-height: 680px; border-inline: 1px solid var(--color-app-ink-line); border-bottom: 1px solid var(--color-app-ink-line); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 4.5rem clamp(1.25rem, 4vw, 4rem); border-right: 1px solid var(--color-app-ink-line); }
  .eyebrow, .section-label { color: var(--color-app-accent); font: .66rem/1 var(--font-mono); letter-spacing: .17em; text-transform: uppercase; }
  .eyebrow::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  h1 { margin: 1.75rem 0 3.5rem; font: 750 clamp(4.2rem, 10vw, 9.6rem)/.75 var(--font-display); letter-spacing: -.065em; }
  h1 > span { display: block; }
  h1 .shift { padding-left: clamp(0rem, 8vw, 8rem); }
  h1 i, .hero-intro h2 i, .oss-heading h2 i { color: var(--color-app-accent); font-family: var(--font-serif); font-weight: 400; }
  .hero-intro { display: grid; grid-template-columns: 5rem minmax(0, 36rem); gap: 1.5rem; margin-left: auto; }
  .hero-intro > span { padding-top: .45rem; border-top: 1px solid var(--color-app-accent); color: var(--color-app-accent); font: .6rem/1.2 var(--font-mono); }
  .hero-intro h2 { margin-bottom: 1rem; font: 560 clamp(1.4rem, 2.3vw, 2.3rem)/1.1 var(--font-display); letter-spacing: -.035em; }
  .hero-intro p { color: var(--color-app-gray-500); font-size: .9rem; line-height: 1.6; }
  .ledger-summary { display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; background: var(--color-app-surface); }
  .ledger-summary > div { display: flex; justify-content: space-between; color: var(--color-app-gray-400); font: .57rem/1 var(--font-mono); letter-spacing: .1em; }
  .ledger-summary > div span:first-child { color: var(--color-app-accent); }
  .ledger-summary dl { border-top: 2px solid var(--color-app-text); }
  .ledger-summary dl > div { display: grid; grid-template-columns: 1fr auto; align-items: baseline; padding: 1.1rem .25rem; border-bottom: 1px solid var(--color-app-border); }
  .ledger-summary dt, .ledger-summary > p { color: var(--color-app-gray-400); font: .58rem/1.6 var(--font-mono); letter-spacing: .08em; }
  .ledger-summary dd { color: var(--color-app-accent); font: 650 clamp(1.7rem, 3vw, 3rem)/1 var(--font-display); }
  .project-register { padding: clamp(5rem, 9vw, 8rem) 0; }
  .category-section { margin-bottom: clamp(5rem, 9vw, 8rem); }
  .category-section:last-child { margin-bottom: 0; }
  .category-heading { display: grid; grid-template-columns: .8fr 1.7fr; gap: 2rem; align-items: end; margin-bottom: 2.5rem; }
  .category-heading > div, .oss-heading > div { display: flex; gap: 1rem; align-items: center; }
  .section-index { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .68rem/1 var(--font-mono); }
  .category-heading h2 { font: 650 clamp(3rem, 6.5vw, 6.5rem)/.82 var(--font-display); letter-spacing: -.06em; text-transform: uppercase; }
  .project-ledger { border-top: 2px solid var(--color-app-text); }
  .project-ledger > li { border-bottom: 1px solid var(--color-app-ink-line); }
  .project-ledger article { display: grid; grid-template-columns: 5rem minmax(0, 1.4fr) minmax(12rem, .7fr) minmax(7rem, .35fr); gap: 2rem; padding: 2.5rem .5rem; }
  .project-index { display: flex; flex-direction: column; justify-content: space-between; color: var(--color-app-gray-400); font: .55rem/1.3 var(--font-mono); letter-spacing: .08em; }
  .project-index span:first-child { color: var(--color-app-accent); }
  .project-main h3 { font: 640 clamp(2rem, 4.4vw, 4.5rem)/.88 var(--font-display); letter-spacing: -.055em; }
  .project-main > p { max-width: 48rem; margin: 1.25rem 0 1.5rem; color: var(--color-app-gray-500); font-size: .84rem; line-height: 1.6; }
  .project-main ul { display: flex; flex-wrap: wrap; gap: .35rem; }
  .project-main li { padding: .35rem .5rem; border: 1px solid var(--color-app-border); color: var(--color-app-gray-500); font: .55rem/1 var(--font-mono); text-transform: uppercase; }
  .project-ledger figure, .no-figure { align-self: start; aspect-ratio: 1.45; border: 1px solid var(--color-app-border); overflow: hidden; background: var(--color-app-surface); }
  .project-ledger figure img { width: 100%; height: 100%; padding: .65rem; object-fit: contain; filter: grayscale(1); transition: filter .3s, transform .4s; }
  .project-ledger article:hover figure img { filter: grayscale(0); transform: scale(1.025); }
  .no-figure { display: flex; flex-direction: column; justify-content: space-between; padding: .75rem; color: var(--color-app-gray-400); font: .55rem/1 var(--font-mono); }
  .no-figure strong { align-self: flex-end; color: var(--color-app-gray-300); font: 650 2rem/1 var(--font-display); }
  .project-links { display: flex; flex-direction: column; align-items: flex-end; gap: .8rem; }
  .project-links > span { margin-bottom: .5rem; color: var(--color-app-gray-400); font: .52rem/1 var(--font-mono); letter-spacing: .08em; }
  .project-links a { padding-bottom: .2rem; border-bottom: 1px solid currentColor; font: .6rem/1 var(--font-mono); text-transform: uppercase; }
  .project-links a:hover { color: var(--color-app-accent); }
  .oss-section { padding: clamp(5rem, 10vw, 9rem) 0; color: var(--color-app-inverse-text); background: var(--color-app-inverse); }
  .oss-heading { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 2rem; align-items: start; margin-bottom: 4rem; }
  .oss-heading .section-index { color: var(--color-app-accent); background: var(--color-app-inverse-text); }
  .oss-heading .section-label, .oss-heading h2 i { color: var(--color-app-inverse-accent); }
  .oss-heading h2 { font: 650 clamp(2.8rem, 5.8vw, 6rem)/.88 var(--font-display); letter-spacing: -.055em; }
  .oss-heading > p { color: var(--color-app-inverse-muted); font-size: .88rem; line-height: 1.55; }
  .oss-ledger { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--color-app-inverse-text); }
  .oss-ledger > li { padding: 2rem; border-right: 1px solid var(--color-app-inverse-line); border-bottom: 1px solid var(--color-app-inverse-line); }
  .oss-ledger > li:nth-child(even) { border-right: 0; }
  .oss-ledger article > header { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: baseline; margin-bottom: 1.5rem; }
  .oss-ledger article > header span, .oss-ledger article > header strong { color: var(--color-app-inverse-muted); font: .55rem/1 var(--font-mono); letter-spacing: .08em; }
  .oss-ledger article > header span { color: var(--color-app-inverse-accent); }
  .oss-ledger h3 { font: 600 clamp(1.2rem, 2.2vw, 2rem)/1 var(--font-display); letter-spacing: -.035em; }
  .oss-ledger article ol { border-top: 1px solid var(--color-app-inverse-line); }
  .oss-ledger article li a { display: grid; grid-template-columns: 2rem 1fr auto; gap: .6rem; padding: .8rem .2rem; border-bottom: 1px solid var(--color-app-inverse-line); color: var(--color-app-inverse-muted); font-size: .76rem; line-height: 1.4; }
  .oss-ledger article li a span:first-child, .oss-ledger article li a span:last-child { color: var(--color-app-inverse-accent); font: .55rem/1.5 var(--font-mono); }
  .oss-ledger article li a:hover { color: var(--color-app-inverse-text); }
  .reveal { opacity: 0; animation: reveal .75s cubic-bezier(.16,1,.3,1) forwards; animation-delay: calc(var(--delay) * 90ms + 100ms); }
  @keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1000px) {
    .project-ledger article { grid-template-columns: 4rem 1.3fr .7fr; }
    .project-links { grid-column: 2 / -1; flex-direction: row; align-items: flex-start; }
    .project-links > span { margin-right: auto; }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .ledger-summary { min-height: 28rem; }
    .oss-heading { grid-template-columns: 1fr 2fr; }
    .oss-heading > p { grid-column: 2; }
    .oss-ledger { grid-template-columns: 1fr; }
    .oss-ledger > li { border-right: 0; }
  }
  @media (max-width: 640px) {
    .status-line { grid-template-columns: 1fr auto; }
    .status-line span:last-child { display: none; }
    .hero-grid { min-height: auto; }
    .hero-copy { padding: 3.5rem 1rem; }
    h1 { font-size: clamp(3.8rem, 18vw, 6rem); }
    h1 .shift { padding-left: 0; }
    .hero-intro { grid-template-columns: 1fr; margin: 0; }
    .hero-intro > span { width: 5rem; }
    .category-heading { grid-template-columns: 1fr; }
    .project-ledger article { grid-template-columns: 2rem 1fr; gap: 1rem; }
    .project-index { min-height: 4rem; }
    .project-ledger figure, .no-figure, .project-links { grid-column: 2; }
    .project-links { flex-wrap: wrap; }
    .project-links > span { width: 100%; }
    .oss-heading { display: flex; flex-direction: column; }
    .oss-ledger > li { padding: 1.5rem .5rem; }
    .oss-ledger article > header { grid-template-columns: 1fr auto; }
    .oss-ledger article > header h3 { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; animation: none; } .project-ledger figure img { transition: none; } }
</style>
