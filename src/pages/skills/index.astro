---
import BaseLayout from "../../components/BaseLayout.astro";
import { Code } from "astro:components";
import { getCollection } from "astro:content";

const allSkills = await getCollection("agent-skills");
const sortedSkills = allSkills.sort((a, b) => a.data.title.localeCompare(b.data.title));
const categoryCount = new Set(sortedSkills.map((skill) => skill.data.category)).size;
const tools = [
  { label: "Claude Code", cmd: "ln -s .agents/skills .claude/skills" },
  { label: "OpenCode", cmd: "ln -s .agents/skills .opencode/skills" },
  { label: "Cursor", cmd: "ln -s .agents/skills .cursor/rules" },
  { label: "Windsurf", cmd: "ln -s .agents/skills .windsurf/rules" },
  { label: "Gemini CLI", cmd: "ln -s .agents/skills .gemini/skills" },
];
---

<BaseLayout
  title="Agent Library - Dipankar Das"
  description="A collection of specialized AI Agent skill modules (SKILLS.md) for automated engineering workflows."
  blogPost={true}
  bodyClass="skills-registry"
>
  <div class="registry-shell">
    <section class="registry-intake container mx-auto">
      <div class="status-rail reveal" style="--delay: 0">
        <span>SYS / AGENT MODULE REGISTRY</span>
        <span class="live"><i></i> PUBLIC INDEX</span>
        <span>REV / 01.7</span>
      </div>

      <div class="intake-grid">
        <header class="registry-heading">
          <p class="kicker-line reveal" style="--delay: 1">Agent-readable field library</p>
          <h1 class="reveal" style="--delay: 2">SYSTEM<br /><span>MANIFEST.</span></h1>
          <div class="heading-note reveal" style="--delay: 3">
            <span>00</span>
            <p>High-context operating modules that teach coding agents how to reason, decide, and execute like systems engineers.</p>
          </div>
        </header>

        <aside class="intake-telemetry reveal" style="--delay: 4" aria-label="Registry telemetry">
          <div class="telemetry-mark">A/<br />SK</div>
          <dl>
            <div><dt>Modules online</dt><dd>{String(sortedSkills.length).padStart(2, "0")}</dd></div>
            <div><dt>Operational classes</dt><dd>{String(categoryCount).padStart(2, "0")}</dd></div>
            <div><dt>Source format</dt><dd>SKILL.md</dd></div>
            <div><dt>Interface</dt><dd>.well-known</dd></div>
          </dl>
          <span class="telemetry-caption">FIG 01 / CAPABILITY BUS</span>
        </aside>
      </div>
    </section>

    <section class="protocol-section">
      <div class="container mx-auto protocol-grid">
        <header>
          <div class="section-code"><span>01</span> LOAD PROTOCOL</div>
          <h2>One source.<br /><i>Every agent.</i></h2>
          <p>Keep the instruction set canonical. Route each runtime to it without cloning or drift.</p>
        </header>

        <ol class="protocol-ledger">
          <li>
            <span class="step-no">01 / STORE</span>
            <div>
              <p>Place each module at the canonical project path.</p>
              <code>.agents/skills/&lt;skill-name&gt;/SKILL.md</code>
            </div>
          </li>
          <li>
            <span class="step-no">02 / ROUTE</span>
            <div class="route-control">
              <p>Select an agent interface and generate its symbolic route.</p>
              <div class="tool-switch" aria-label="Agent tool selection">
                {tools.map((tool, index) => (
                  <button class:list={["tool-tab", { "is-active": index === 0 }]} data-cmd={tool.cmd} aria-pressed={index === 0 ? "true" : "false"}>
                    {String(index + 1).padStart(2, "0")} {tool.label}
                  </button>
                ))}
              </div>
              <code id="tool-cmd">ln -s .agents/skills .claude/skills</code>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="manifest-section container mx-auto">
      <header class="manifest-head">
        <div class="section-code"><span>02</span> ACTIVE MODULES</div>
        <h2>Capability<br /><i>ledger.</i></h2>
        <div class="manifest-key">
          <span>SELECT ROW TO INSPECT</span>
          <span>↓ {sortedSkills.length} RECORDS</span>
        </div>
      </header>

      <div class="ledger-labels" aria-hidden="true">
        <span>REC</span><span>MODULE / PURPOSE</span><span>CLASS</span><span>REV</span><span>SIGNAL</span>
      </div>
      <ol class="module-ledger">
        {sortedSkills.map((skill, index) => (
          <li>
            <button
              class="skill-card"
              data-skill-id={skill.id}
              data-skill-title={skill.data.title}
              data-skill-description={skill.data.description}
              data-skill-category={skill.data.category}
              data-skill-version={skill.data.version ?? ""}
              data-skill-inspiration={skill.data.inspiration ?? ""}
              data-skill-why={skill.data.why ?? ""}
              data-skill-body={skill.body}
            >
              <span class="record-no">M{String(index + 1).padStart(2, "0")}</span>
              <span class="module-primary"><strong>{skill.data.title}</strong><small>{skill.data.description}</small></span>
              <span class="module-category">{skill.data.category}</span>
              <span class="module-version">{skill.data.version ? `v${skill.data.version}` : "UNVER."}</span>
              <span class="module-signal"><i></i> INSPECT <b>↗</b></span>
            </button>
          </li>
        ))}
      </ol>

      <footer class="registry-support">
        <span>FIELD LIBRARY / OPEN ACCESS</span>
        <p>These modules are free to use. If they save time or sharpen a workflow, support continued fieldwork.</p>
        <a href="https://github.com/sponsors/dipankardas011" target="_blank" rel="noopener noreferrer">SPONSOR THE REGISTRY <span>↗</span></a>
      </footer>
    </section>
  </div>

  <dialog id="skill-dialog" class="inspection-dialog">
    <div class="dialog-bar">
      <div><span>MODULE INSPECTION</span><b id="dialog-category"></b><span id="dialog-version"></span></div>
      <button id="dialog-close" aria-label="Close module inspection">CLOSE [×]</button>
    </div>

    <div class="dialog-grid">
      <section class="dialog-brief">
        <span class="pane-label">01 / OPERATING BRIEF</span>
        <h2 id="dialog-title"></h2>
        <p id="dialog-description" class="dialog-description"></p>
        <div id="dialog-inspiration-wrap" class="brief-note hidden">
          <span>ORIGIN SIGNAL</span><p id="dialog-inspiration"></p>
        </div>
        <div id="dialog-why-wrap" class="brief-note hidden">
          <span>DESIGN LOGIC</span><p id="dialog-why"></p>
        </div>
      </section>

      <section class="dialog-source">
        <div class="source-controls">
          <span class="pane-label">02 / RAW DIRECTIVE · SKILL.md</span>
          <div>
            <button id="btn-copy"><span id="copy-label">COPY</span></button>
            <button id="btn-share" title="Copy .well-known URL"><span id="share-label">URL</span></button>
            <button id="btn-download">DOWNLOAD</button>
          </div>
        </div>
        <a id="dialog-skill-url" href="#" target="_blank" rel="noopener noreferrer" class="source-route">
          <span>PUBLIC ROUTE</span><code id="dialog-skill-url-text"></code><b>↗</b>
        </a>
        <div class="code-vault">
          <div id="dialog-code"></div>
          <div id="code-fade"><span id="more-lines-label">↓ SCROLL FOR MORE</span></div>
        </div>
      </section>
    </div>
  </dialog>

  <div class="hidden" aria-hidden="true">
    {sortedSkills.map((skill) => (
      <div id={`code-${skill.id}`}><Code code={skill.body} lang="markdown" theme="everforest-dark" /></div>
    ))}
  </div>
</BaseLayout>

<script>
  const dialog = document.getElementById('skill-dialog') as HTMLDialogElement | null;
  const titleEl = document.getElementById('dialog-title');
  const descEl = document.getElementById('dialog-description');
  const catEl = document.getElementById('dialog-category');
  const verEl = document.getElementById('dialog-version');
  const inspWrap = document.getElementById('dialog-inspiration-wrap');
  const inspEl = document.getElementById('dialog-inspiration');
  const whyWrap = document.getElementById('dialog-why-wrap');
  const whyEl = document.getElementById('dialog-why');
  const codeEl = document.getElementById('dialog-code');
  const codeFade = document.getElementById('code-fade');
  const moreLinesLabel = document.getElementById('more-lines-label');
  const btnCopy = document.getElementById('btn-copy');
  const btnShare = document.getElementById('btn-share');
  const btnDl = document.getElementById('btn-download');
  const copyLabel = document.getElementById('copy-label');
  const shareLabel = document.getElementById('share-label');
  const skillUrlEl = document.getElementById('dialog-skill-url') as HTMLAnchorElement | null;
  const skillUrlText = document.getElementById('dialog-skill-url-text');
  let currentBody = '';
  let currentId = '';

  function resetCodeFade() {
    if (!codeEl || !codeFade) return;
    codeEl.scrollTop = 0;
    requestAnimationFrame(() => {
      if (!codeEl || !codeFade) return;
      const overflows = codeEl.scrollHeight > codeEl.clientHeight + 4;
      codeFade.style.display = overflows ? '' : 'none';
      if (overflows && moreLinesLabel) {
        const hiddenLines = Math.round((codeEl.scrollHeight - codeEl.clientHeight) / 19);
        moreLinesLabel.textContent = `↓ ${hiddenLines} MORE LINE${hiddenLines !== 1 ? 'S' : ''}`;
      }
    });
  }

  function open(btn: HTMLElement) {
    if (!dialog) return;
    currentBody = btn.dataset.skillBody ?? '';
    currentId = btn.dataset.skillId ?? '';
    if (titleEl) titleEl.textContent = btn.dataset.skillTitle ?? '';
    if (descEl) descEl.textContent = btn.dataset.skillDescription ?? '';
    if (catEl) catEl.textContent = btn.dataset.skillCategory ?? '';
    if (verEl) verEl.textContent = btn.dataset.skillVersion ? `REV / ${btn.dataset.skillVersion}` : 'REV / UNVERIFIED';
    if (codeEl) {
      const source = document.getElementById(`code-${currentId}`);
      codeEl.innerHTML = source ? source.innerHTML : `<pre>${currentBody}</pre>`;
      resetCodeFade();
    }
    const inspiration = btn.dataset.skillInspiration ?? '';
    if (inspEl && inspWrap) {
      inspWrap.classList.toggle('hidden', !inspiration);
      if (inspiration) inspEl.textContent = `“${inspiration}”`;
    }
    const why = btn.dataset.skillWhy ?? '';
    if (whyEl && whyWrap) {
      whyWrap.classList.toggle('hidden', !why);
      if (why) whyEl.textContent = why;
    }
    if (copyLabel) copyLabel.textContent = 'COPY';
    if (shareLabel) shareLabel.textContent = 'URL';
    const skillUrl = `https://dipankar-das.com/.well-known/agent-skills/${currentId}/SKILL.md`;
    if (skillUrlEl) skillUrlEl.href = skillUrl;
    if (skillUrlText) skillUrlText.textContent = skillUrl;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  }

  function close() {
    dialog?.close();
    document.body.style.overflow = '';
  }

  const toolCmd = document.getElementById('tool-cmd');
  const toolTabs = document.querySelectorAll<HTMLElement>('.tool-tab');
  toolTabs.forEach((tab) => tab.addEventListener('click', () => {
    toolTabs.forEach((item) => {
      item.classList.remove('is-active');
      item.setAttribute('aria-pressed', 'false');
    });
    tab.classList.add('is-active');
    tab.setAttribute('aria-pressed', 'true');
    if (toolCmd) toolCmd.textContent = tab.dataset.cmd ?? '';
  }));

  document.querySelectorAll<HTMLElement>('.skill-card').forEach((card) => card.addEventListener('click', () => open(card)));
  document.getElementById('dialog-close')?.addEventListener('click', close);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) close(); });
  window.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  btnCopy?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(currentBody);
    if (copyLabel) copyLabel.textContent = 'COPIED';
    setTimeout(() => { if (copyLabel) copyLabel.textContent = 'COPY'; }, 2000);
  });
  btnShare?.addEventListener('click', async () => {
    const url = skillUrlEl?.href ?? `https://dipankar-das.com/.well-known/agent-skills/${currentId}/SKILL.md`;
    await navigator.clipboard.writeText(url);
    if (shareLabel) shareLabel.textContent = 'COPIED';
    setTimeout(() => { if (shareLabel) shareLabel.textContent = 'URL'; }, 2000);
  });
  btnDl?.addEventListener('click', () => {
    const anchor = document.createElement('a');
    anchor.href = URL.createObjectURL(new Blob([currentBody], { type: 'text/markdown' }));
    anchor.download = `${currentId}.md`;
    document.body.appendChild(anchor);
    anchor.click();
    document.body.removeChild(anchor);
  });
</script>

<style>
  :global(.skills-registry footer.mt-16) { margin-top: 0; }
  .registry-shell { overflow: hidden; }
  .registry-intake { padding-top: 1.25rem; }
  .status-rail { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .72rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .6rem/1 var(--font-mono); letter-spacing: .12em; }
  .status-rail > :last-child { text-align: right; }
  .live { color: var(--color-app-text); }
  .live i, .module-signal i { display: inline-block; width: .42rem; height: .42rem; margin-right: .45rem; border-radius: 50%; background: var(--color-app-accent); box-shadow: 0 0 0 .22rem color-mix(in srgb, var(--color-app-accent) 10%, transparent); animation: pulse 2s infinite; }
  .intake-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(18rem, .6fr); min-height: 610px; border-inline: 1px solid var(--color-app-ink-line); }
  .registry-heading { display: flex; flex-direction: column; justify-content: center; padding: 4.5rem clamp(1.25rem, 5vw, 5rem); border-right: 1px solid var(--color-app-ink-line); }
  .kicker-line, .section-code, .pane-label { color: var(--color-app-accent); font: .64rem/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
  .kicker-line::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  .registry-heading h1 { margin: 2rem 0 2.5rem; font: 750 clamp(4.6rem, 11vw, 10.5rem)/.73 var(--font-display); letter-spacing: -.07em; }
  .registry-heading h1 span, .protocol-section h2 i, .manifest-head h2 i { color: var(--color-app-accent); font-family: var(--font-serif); font-weight: 400; }
  .heading-note { display: grid; grid-template-columns: 2rem minmax(0, 35rem); gap: 1rem; max-width: 42rem; margin-left: auto; }
  .heading-note span { padding-top: .4rem; border-top: 1px solid var(--color-app-accent); color: var(--color-app-accent); font: .62rem/1 var(--font-mono); }
  .heading-note p { color: var(--color-app-gray-500); font-size: clamp(.95rem, 1.35vw, 1.15rem); line-height: 1.55; }
  .intake-telemetry { display: flex; flex-direction: column; justify-content: space-between; padding: 1rem; background: var(--color-app-surface); }
  .telemetry-mark { padding: 1.5rem; color: var(--color-app-accent); background: var(--color-app-body); font: 700 clamp(4rem, 7vw, 7rem)/.72 var(--font-display); letter-spacing: -.08em; clip-path: polygon(0 0, 84% 0, 100% 14%, 100% 100%, 0 100%); }
  .intake-telemetry dl { border-top: 1px solid var(--color-app-ink-line); }
  .intake-telemetry dl div { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--color-app-border); }
  .intake-telemetry dt, .intake-telemetry dd, .telemetry-caption { font: .57rem/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .intake-telemetry dt, .telemetry-caption { color: var(--color-app-gray-400); }
  .intake-telemetry dd { color: var(--color-app-text); }
  .telemetry-caption { display: flex; justify-content: space-between; }
  .telemetry-caption::after { content: "READY"; color: var(--color-app-accent); }

  .protocol-section { padding: clamp(5rem, 9vw, 8rem) 0; color: var(--color-app-inverse-text); background: var(--color-app-inverse); }
  .protocol-grid { display: grid; grid-template-columns: .7fr 1.45fr; gap: clamp(3rem, 8vw, 8rem); }
  .section-code { display: flex; align-items: center; gap: .8rem; }
  .section-code span { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); }
  .protocol-section .section-code { color: var(--color-app-inverse-accent); }
  .protocol-section .section-code span { color: var(--color-app-inverse-text); background: var(--color-app-inverse-accent); }
  .protocol-section h2, .manifest-head h2 { margin: 2.5rem 0 1.5rem; font: 650 clamp(2.8rem, 5.5vw, 5.8rem)/.86 var(--font-display); letter-spacing: -.055em; }
  .protocol-section h2 i { color: var(--color-app-inverse-accent); }
  .protocol-section header > p { max-width: 22rem; color: var(--color-app-inverse-muted); font-size: .9rem; line-height: 1.55; }
  .protocol-ledger { border-top: 2px solid var(--color-app-inverse-text); }
  .protocol-ledger > li { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; padding: 1.6rem 0; border-bottom: 1px solid var(--color-app-inverse-line); }
  .step-no { color: var(--color-app-inverse-accent); font: .6rem/1 var(--font-mono); letter-spacing: .08em; }
  .protocol-ledger p { margin-bottom: 1rem; font-size: .86rem; }
  .protocol-ledger code { display: block; padding: .9rem 1rem; border-left: 4px solid var(--color-app-inverse-accent); color: var(--color-app-inverse-text); background: color-mix(in srgb, var(--color-app-inverse-text) 7%, transparent); font: .68rem/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .tool-switch { display: flex; flex-wrap: wrap; border-top: 1px solid var(--color-app-inverse-line); border-left: 1px solid var(--color-app-inverse-line); }
  .tool-tab { padding: .7rem .8rem; border-right: 1px solid var(--color-app-inverse-line); border-bottom: 1px solid var(--color-app-inverse-line); color: var(--color-app-inverse-muted); font: .57rem/1 var(--font-mono); text-transform: uppercase; transition: color .2s, background .2s; }
  .tool-tab:hover, .tool-tab.is-active { color: var(--color-app-inverse); background: var(--color-app-inverse-text); }
  .route-control #tool-cmd { margin-top: .8rem; }

  .manifest-section { padding-block: clamp(5rem, 10vw, 9rem); }
  .manifest-head { display: grid; grid-template-columns: .75fr 1.4fr .7fr; gap: 2rem; align-items: end; margin-bottom: 4rem; }
  .manifest-head h2 { margin: 0; }
  .manifest-key { display: flex; flex-direction: column; gap: .75rem; padding-left: 1rem; border-left: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .58rem/1 var(--font-mono); letter-spacing: .08em; }
  .manifest-key span:last-child { color: var(--color-app-accent); }
  .ledger-labels, .skill-card { display: grid; grid-template-columns: 4rem minmax(0, 1.5fr) minmax(7rem, .55fr) 5rem 7rem; gap: 1.5rem; }
  .ledger-labels { padding: .7rem .5rem; border-block: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .55rem/1 var(--font-mono); letter-spacing: .1em; }
  .module-ledger { counter-reset: modules; }
  .module-ledger li { border-bottom: 1px solid var(--color-app-border); }
  .skill-card { width: 100%; align-items: start; padding: 1.75rem .5rem; text-align: left; transition: padding .22s, background .22s; }
  .skill-card:hover, .skill-card:focus-visible { padding-inline: 1rem; background: var(--color-app-surface); outline: none; }
  .record-no, .module-category, .module-version, .module-signal { color: var(--color-app-gray-400); font: .58rem/1.35 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .record-no { color: var(--color-app-accent); }
  .module-primary { display: flex; flex-direction: column; gap: .65rem; }
  .module-primary strong { font: 600 clamp(1.35rem, 2.3vw, 2.3rem)/.95 var(--font-display); letter-spacing: -.035em; transition: color .2s; }
  .module-primary small { max-width: 38rem; color: var(--color-app-gray-400); font-size: .78rem; line-height: 1.5; }
  .skill-card:hover .module-primary strong { color: var(--color-app-accent); }
  .module-category { padding: .35rem .45rem; border: 1px solid var(--color-app-border); }
  .module-signal { color: var(--color-app-text); text-align: right; }
  .module-signal i { animation: none; }
  .module-signal b { display: inline-block; margin-left: .3rem; color: var(--color-app-accent); transition: transform .2s; }
  .skill-card:hover .module-signal b { transform: translate(.2rem, -.2rem); }
  .registry-support { display: grid; grid-template-columns: .7fr 1.3fr auto; gap: 2rem; align-items: center; margin-top: 4rem; padding: 1.5rem; border: 1px solid var(--color-app-accent); }
  .registry-support > span, .registry-support a { color: var(--color-app-accent); font: .6rem/1.4 var(--font-mono); letter-spacing: .09em; }
  .registry-support p { color: var(--color-app-gray-400); font-size: .82rem; line-height: 1.5; }
  .registry-support a { padding-bottom: .3rem; border-bottom: 1px solid; }

  .inspection-dialog { width: min(76rem, calc(100% - 2rem)); max-height: calc(100svh - 2rem); margin: auto; padding: 0; border: 1px solid var(--color-app-ink-line); color: var(--color-app-text); background: var(--color-app-body); box-shadow: .7rem .7rem 0 var(--color-app-accent); overflow: hidden; }
  .inspection-dialog::backdrop { background: color-mix(in srgb, var(--color-app-body) 88%, transparent); backdrop-filter: blur(5px); }
  .dialog-bar { display: flex; justify-content: space-between; align-items: center; min-height: 3.4rem; padding: .7rem 1rem; border-bottom: 1px solid var(--color-app-ink-line); font: .57rem/1 var(--font-mono); letter-spacing: .09em; }
  .dialog-bar > div { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .dialog-bar b { padding: .35rem .45rem; color: var(--color-app-accent); border: 1px solid var(--color-app-border); font-weight: 400; }
  .dialog-bar span { color: var(--color-app-gray-400); }
  .dialog-bar button { padding: .5rem; color: var(--color-app-gray-400); transition: color .2s, background .2s; }
  .dialog-bar button:hover { color: var(--color-app-accent-ink); background: var(--color-app-accent); }
  .dialog-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); max-height: calc(100svh - 5.4rem); overflow-y: auto; }
  .dialog-brief, .dialog-source { min-width: 0; padding: clamp(1.4rem, 3vw, 2.8rem); }
  .dialog-brief { border-right: 1px solid var(--color-app-ink-line); }
  .dialog-brief h2 { margin: 2.2rem 0 1rem; font: 650 clamp(2.2rem, 4.5vw, 4.8rem)/.86 var(--font-display); letter-spacing: -.055em; overflow-wrap: anywhere; }
  .dialog-description { color: var(--color-app-gray-500); font-size: .92rem; line-height: 1.6; }
  .brief-note { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--color-app-border); }
  .brief-note span { color: var(--color-app-accent); font: .55rem/1 var(--font-mono); letter-spacing: .12em; }
