---
import BaseLayout from "../../components/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { siteConfig, socialLinks } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts
    .filter((p) => p.id !== "external-blogs")
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// ---- Table of Contents data ----
const tocHeadings = headings.filter((h) => h.depth <= 3);
let h2Counter = 0;
const tocItems = tocHeadings.map((h) => {
  if (h.depth === 2) h2Counter++;
  return {
    ...h,
    num: h.depth === 2 ? String(h2Counter).padStart(2, "0") : null,
  };
});

const allPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((p) => p.id !== "external-blogs" && p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const wordCount = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout
  title={`${post.data.title} - Dipankar Das`}
  description={post.data.description}
  ogImage={post.data.cover}
  blogPost={true}
  publishedDate={post.data.date}
  author={post.data.author ?? siteConfig.name}
  tags={post.data.tags}
>
  <div id="reading-progress"></div>

  <article class="field-article">
    <header class="article-header">
      <div class="container mx-auto">
        <div class="document-line">
          <a href="/blog/">← FIELD NOTES</a>
          <span>DOCUMENT / {post.id.toUpperCase()}</span>
          <span>CLASS / PUBLIC</span>
        </div>
        <div class="title-grid">
          <div class="title-copy">
            <span class="record-label">RECORD / LONG-FORM</span>
            <h1>{post.data.title}</h1>
            {post.data.description && <p class="article-lede">{post.data.description}</p>}
          </div>
          <aside class="article-meta" aria-label="Article metadata">
            <span class="meta-index">01</span>
            <dl>
              <div><dt>Filed</dt><dd><time datetime={post.data.date.toISOString()}>{formattedDate}</time></dd></div>
              <div><dt>Read time</dt><dd>{readingTime} minutes</dd></div>
              <div><dt>Length</dt><dd>{wordCount.toLocaleString()} words</dd></div>
              <div><dt>Author</dt><dd>{post.data.author ?? siteConfig.name}</dd></div>
            </dl>
            {post.data.tags && post.data.tags.length > 0 && (
              <ul aria-label="Article tags">{post.data.tags.map((tag: string) => <li>{tag}</li>)}</ul>
            )}
          </aside>
        </div>
        {post.data.cover && (
          <figure class="cover-panel">
            <img src={post.data.cover} alt={post.data.title} loading="eager" />
            <figcaption><span>FIG / 01</span><span>PRIMARY RECORD IMAGE</span></figcaption>
          </figure>
        )}
      </div>
    </header>

    <div class="article-body container mx-auto">
      {tocItems.length > 1 && (
        <aside class="toc-sidebar">
          <div class="toc-sticky">
            <p class="toc-label">02 / Contents</p>
            <nav id="toc-nav" class="toc-nav" aria-label="Table of contents">
              {tocItems.map((item) => (
                <a href={`#${item.slug}`} class={`toc-link${item.depth === 3 ? " toc-h3" : ""}`} data-heading-id={item.slug}>
                  {item.num && <span class="toc-num">{item.num}</span>}{item.text}
                </a>
              ))}
              <div class="toc-indicator" aria-hidden="true"></div>
            </nav>
          </div>
        </aside>
      )}

      <div class="reading-column">
        {tocItems.length > 1 && (
          <div class="toc-mobile-wrapper">
            <button type="button" id="toc-mobile-toggle" class="toc-mobile-toggle" aria-expanded="false" aria-controls="toc-mobile">
              <span>02 / Document contents</span>
              <svg class="toc-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
            </button>
            <nav id="toc-mobile" class="toc-mobile-nav" aria-label="Mobile table of contents">
              {tocItems.map((item) => (
                <a href={`#${item.slug}`} class={`toc-link${item.depth === 3 ? " toc-h3" : ""}`} data-heading-id={item.slug}>
                  {item.num && <span class="toc-num">{item.num}</span>}{item.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <div class="entry-rule" aria-hidden="true"><span>BEGIN RECORD</span><i></i></div>
        <div class="prose prose-lg"><Content /></div>

        <footer class="operator-card">
          <img src="/img/profile_bw.webp" alt="" />
          <div>
            <span>OPERATOR / AUTHOR</span>
            <h2>{siteConfig.name}</h2>
            <p>{siteConfig.tagline}</p>
            <nav aria-label="Author links">
              <a href={socialLinks.github} target="_blank" rel="noopener">GitHub ↗</a>
              <a href={socialLinks.twitter} target="_blank" rel="noopener">Twitter ↗</a>
              <a href={socialLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
              <a href={socialLinks.sponsor} target="_blank" rel="noopener">Sponsor ↗</a>
            </nav>
          </div>
        </footer>
      </div>
    </div>

    {allPosts.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="container mx-auto related-grid">
          <header><span>03 / CONTINUE</span><h2 id="related-heading">Next<br /><i>records.</i></h2><a href="/blog/">Full archive →</a></header>
          <ol>
            {allPosts.map((otherPost, index) => (
              <li><a href={`/blog/${otherPost.id}/`}><span>R-{String(index + 1).padStart(2, "0")}</span><div><time datetime={otherPost.data.date.toISOString()}>{otherPost.data.date.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" }).toUpperCase()}</time><h3>{otherPost.data.title}</h3><p>{otherPost.data.description}</p></div><b>↗</b></a></li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .field-article { padding-top: 1.25rem; }
  .document-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .7rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .58rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .document-line a { color: var(--color-app-text); }
  .document-line span:last-child { color: var(--color-app-accent); text-align: right; }
  .title-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(18rem, .55fr); border-inline: 1px solid var(--color-app-ink-line); border-bottom: 1px solid var(--color-app-ink-line); }
  .title-copy { display: flex; flex-direction: column; justify-content: center; min-height: 34rem; padding: clamp(3rem, 7vw, 7rem) clamp(1rem, 4vw, 4rem); border-right: 1px solid var(--color-app-ink-line); }
  .record-label { color: var(--color-app-accent); font: .62rem/1 var(--font-mono); letter-spacing: .16em; }
  .record-label::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  h1 { max-width: 68rem; margin: 1.8rem 0; overflow-wrap: anywhere; font: 700 clamp(3rem, 7vw, 7.2rem)/.86 var(--font-display); letter-spacing: -.06em; }
  .article-lede { max-width: 48rem; color: var(--color-app-gray-500); font: 400 clamp(1.1rem, 1.8vw, 1.45rem)/1.45 var(--font-serif); }
  .article-meta { display: flex; flex-direction: column; justify-content: flex-end; padding: 1.25rem; background: var(--color-app-surface); }
  .meta-index { display: grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: auto; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .62rem/1 var(--font-mono); }
  .article-meta dl { margin-top: 3rem; border-top: 1px solid var(--color-app-ink-line); }
  .article-meta dl div { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid var(--color-app-border); font: .58rem/1.3 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .article-meta dt { color: var(--color-app-gray-400); }
  .article-meta dd { text-align: right; }
  .article-meta ul { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1.5rem; }
  .article-meta li { padding: .35rem .45rem; border: 1px solid var(--color-app-border); color: var(--color-app-gray-500); font: .55rem/1 var(--font-mono); text-transform: uppercase; }
  .cover-panel { margin: 0; border-inline: 1px solid var(--color-app-ink-line); }
  .cover-panel img { display: block; width: 100%; max-height: 43rem; object-fit: cover; filter: grayscale(.85) contrast(1.05); }
  .cover-panel figcaption { display: flex; justify-content: space-between; padding: .65rem .8rem; border-top: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .55rem/1 var(--font-mono); letter-spacing: .12em; }
  .article-body { display: grid; grid-template-columns: 14rem minmax(0, 48rem) 1fr; gap: clamp(2rem, 5vw, 5rem); padding-top: clamp(4rem, 8vw, 8rem); padding-bottom: clamp(5rem, 10vw, 9rem); }
  .toc-sidebar { min-width: 0; }
  .toc-sticky { position: sticky; top: 6rem; }
  .toc-label { padding-bottom: .9rem; border-bottom: 1px solid var(--color-app-ink-line); color: var(--color-app-accent); font: .6rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .reading-column { min-width: 0; }
  .toc-mobile-wrapper { display: none; }
  .entry-rule { display: flex; align-items: center; gap: 1rem; margin-bottom: 3rem; color: var(--color-app-gray-400); font: .57rem/1 var(--font-mono); letter-spacing: .12em; }
  .entry-rule i { flex: 1; height: 1px; background: var(--color-app-ink-line); }
  .reading-column :global(.prose) { font-size: clamp(1rem, 1.2vw, 1.125rem); line-height: 1.75; }
  .operator-card { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; margin-top: 5rem; padding: 1rem; border: 1px solid var(--color-app-ink-line); background: var(--color-app-surface); }
  .operator-card img { width: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(1); }
  .operator-card > div { align-self: center; }
  .operator-card span { color: var(--color-app-accent); font: .55rem/1 var(--font-mono); letter-spacing: .12em; }
  .operator-card h2 { margin: .45rem 0; font: 650 1.5rem/1 var(--font-display); }
  .operator-card p { color: var(--color-app-gray-400); font-size: .78rem; }
  .operator-card nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .8rem; font: .56rem/1 var(--font-mono); text-transform: uppercase; }
  .operator-card a { color: var(--color-app-accent); }
  .related { padding: clamp(5rem, 9vw, 8rem) 0; color: var(--color-app-inverse-text); background: var(--color-app-inverse); }
  .related-grid { display: grid; grid-template-columns: .65fr 1.35fr; gap: clamp(3rem, 8vw, 8rem); }
  .related header > span { color: var(--color-app-inverse-accent); font: .6rem/1 var(--font-mono); letter-spacing: .13em; }
  .related header h2 { margin: 2rem 0; font: 680 clamp(3rem, 6vw, 6rem)/.82 var(--font-display); letter-spacing: -.06em; }
  .related header i { color: var(--color-app-inverse-accent); font-family: var(--font-serif); font-weight: 400; }
  .related header a { padding-bottom: .3rem; border-bottom: 1px solid currentColor; font: .6rem/1 var(--font-mono); text-transform: uppercase; }
  .related ol { border-top: 2px solid var(--color-app-inverse-text); }
  .related li a { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; padding: 1.75rem .4rem; border-bottom: 1px solid var(--color-app-inverse-line); }
  .related li > a > span, .related time { color: var(--color-app-inverse-accent); font: .57rem/1 var(--font-mono); }
  .related h3 { margin-top: .6rem; font: 620 clamp(1.3rem, 2.3vw, 2.2rem)/1 var(--font-display); letter-spacing: -.035em; }
  .related li p { display: -webkit-box; overflow: hidden; margin-top: .5rem; color: var(--color-app-inverse-muted); font-size: .75rem; line-height: 1.45; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .related b { color: var(--color-app-inverse-accent); font-weight: 400; }
  @media (max-width: 1100px) {
    .article-body { grid-template-columns: minmax(0, 48rem); justify-content: center; }
    .toc-sidebar { display: none; }
    .toc-mobile-wrapper { display: block; }
  }
  @media (max-width: 900px) {
    .title-grid { grid-template-columns: 1fr; }
    .title-copy { min-height: 28rem; border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .article-meta { min-height: 18rem; }
    .related-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .document-line { grid-template-columns: 1fr auto; }
    .document-line span:nth-child(2) { display: none; }
    .title-copy { min-height: 24rem; padding-inline: 1rem; }
    h1 { font-size: clamp(2.8rem, 14vw, 4.5rem); }
    .cover-panel img { min-height: 14rem; }
    .operator-card { grid-template-columns: 4.5rem 1fr; }
    .operator-card nav { gap: .7rem; }
  }
</style>

<script>
  // ---- Reading progress bar ----
  const progressBar = document.getElementById("reading-progress");
  if (progressBar) {
    const update = () => {
      const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
      const pct = (scrollTop / (scrollHeight - clientHeight)) * 100;
      progressBar.style.width = Math.min(pct, 100) + "%";
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  // ---- Table of Contents ----
  const tocNav = document.getElementById("toc-nav");
  const tocLinks = tocNav?.querySelectorAll(".toc-link");
  const tocIndicator = tocNav?.querySelector(".toc-indicator");

  if (tocLinks && tocLinks.length > 0 && tocNav) {
    // ── Smooth scroll on click ──
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.getAttribute("href")?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", `#${id}`);
        }
      });
    });

    // ── Collect heading elements matching our TOC links ──
    const headingEls = [];
    tocLinks.forEach((link) => {
      const id = link.dataset.headingId;
      if (id) {
        const el = document.getElementById(id);
        if (el) headingEls.push(el);
      }
    });

    if (headingEls.length > 0) {
      function updateActive() {
        let activeIdx = -1;
        // Find the last heading that's above/before the current scroll
        for (let i = 0; i < headingEls.length; i++) {
          const rect = headingEls[i].getBoundingClientRect();
          if (rect.top <= 120) {
            activeIdx = i;
          }
        }

        tocLinks.forEach((l) => l.classList.remove("toc-active"));
        if (activeIdx >= 0) {
          tocLinks[activeIdx].classList.add("toc-active");
          // Move the indicator
          if (tocIndicator) {
            const activeLink = tocLinks[activeIdx];
            const navRect = tocNav.getBoundingClientRect();
            const linkRect = activeLink.getBoundingClientRect();
            tocIndicator.style.height = `${linkRect.height}px`;
            tocIndicator.style.transform = `translateY(${linkRect.top - navRect.top}px)`;
          }
        }
      }

      updateActive();
      window.addEventListener("scroll", updateActive, { passive: true });
    }
  }

  // ---- Mobile TOC toggle ----
  const tocToggle = document.getElementById("toc-mobile-toggle");
  const tocMobile = document.getElementById("toc-mobile");
  if (tocToggle && tocMobile) {
    tocToggle.addEventListener("click", () => {
      const expanded = tocToggle.getAttribute("aria-expanded") === "true";
      tocToggle.setAttribute("aria-expanded", String(!expanded));
      tocMobile.classList.toggle("toc-mobile-open");
      const icon = tocToggle.querySelector(".toc-toggle-icon");
      if (icon) {
        icon.style.transform = expanded ? "rotate(0deg)" : "rotate(180deg)";
      }
    });

    // Close mobile TOC when clicking a link
    tocMobile.querySelectorAll(".toc-link").forEach((link) => {
      link.addEventListener("click", () => {
        tocToggle.setAttribute("aria-expanded", "false");
        tocMobile.classList.remove("toc-mobile-open");
        const icon = tocToggle.querySelector(".toc-toggle-icon");
        if (icon) icon.style.transform = "rotate(0deg)";
      });
    });
  }

  // ---- Wrap wide tables in a horizontal scroll container ----
  document.querySelectorAll(".prose table").forEach((table) => {
    const parent = table.parentElement;
    if (!parent || parent.classList.contains("table-scroll")) return;
    const wrap = document.createElement("div");
    wrap.className = "table-scroll";
    parent.insertBefore(wrap, table);
    wrap.appendChild(table);
  });

  // ---- Code block language labels ----
  document.querySelectorAll(".prose pre").forEach((pre) => {
    // Shiki sets data-language on pre; fallback to reading the code class
    const lang =
      (pre as HTMLElement).dataset.language ??
      pre.querySelector("code")?.className.match(/language-(\w+)/)?.[1];
    if (lang && lang !== "plaintext" && lang !== "text") {
      (pre as HTMLElement).dataset.lang = lang;
    }
  });
</script>
