---
import BaseLayout from "../components/BaseLayout.astro";
import ContactSection from "../components/ContactSection.astro";
import { experiences, achievements } from "../data/about";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="About - Dipankar Das"
  description="Platform engineer passionate about DevOps, Kubernetes, and sustainable computing."
  bodyClass="about-field-manual"
>
  <div>
    <section class="about-hero">
      <div class="container mx-auto">
        <div class="status-line reveal" style="--delay: 0">
          <span>FIELD DOSSIER / ABOUT</span>
          <span>{experiences.length} ROLES / {achievements.length} MILESTONES</span>
          <span>FILE DD-02 / ACTIVE</span>
        </div>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow reveal" style="--delay: 1">/about · the long version</p>
            <h1 aria-label="About Dipankar Das">
              <span class="reveal" style="--delay: 2">ABOUT</span>
              <span class="shift reveal" style="--delay: 3"><i>THE</i> OPERATOR.</span>
            </h1>
            <div class="intro-statement reveal" style="--delay: 5">
              <span>01 / PROFILE</span>
              <div>
                <h2>{siteConfig.name}, <i>platform engineer</i> who treats infrastructure like a product.</h2>
                <p>{siteConfig.tagline}. I build sustainable platforms and write deep-dives on Software Development, DevOps, Kubernetes, and System Design.</p>
                <p>Most of my work lives at the seam between application code and the infrastructure that runs it — eliminating the "it works on my machine" class of problems for everyone, permanently.</p>
              </div>
            </div>
          </div>

          <figure class="portrait reveal" style="--delay: 4">
            <div class="portrait-frame">
              <img src="/img/profile_bw.webp" alt={siteConfig.name} loading="eager" />
              <span class="scan-line"></span>
              <span class="portrait-id">DD / 011</span>
            </div>
            <figcaption><span>FIG.02 / PORTRAIT, B&amp;W</span><span>2025</span></figcaption>
          </figure>
        </div>

        <dl class="education-ledger" aria-label="Education">
          <div><dt>QUALIFICATION</dt><dd>B.Tech</dd></div>
          <div><dt>DISCIPLINE</dt><dd>Computer Science</dd></div>
          <div><dt>COHORT</dt><dd>Class of 2024</dd></div>
        </dl>
      </div>
    </section>

    <section class="history-section">
      <div class="container mx-auto">
        <header class="section-heading">
          <div><span class="section-index">02</span><span class="section-label">WORK HISTORY</span></div>
          <h2>Roles, in reverse<br /><i>chronology.</i></h2>
          <p>[{String(experiences.length).padStart(2, "0")} ENTRIES]<br />WHY / WHAT / HOW</p>
        </header>

        <ol class="experience-ledger">
          {experiences.map((exp, index) => (
            <li>
              <article>
                <header class="role-heading">
                  <span class="role-number">{String(index + 1).padStart(2, "0")}</span>
                  <div class="role-identity">
                    {exp.logo && <img src={exp.logo} alt="" loading="lazy" />}
                    <div>
                      <h3>
                        {exp.link ? <a href={exp.link} target="_blank" rel="noopener">{exp.company} <span>↗</span></a> : exp.company}
                      </h3>
                      <p>{exp.role}</p>
                    </div>
                  </div>
                  <time>{exp.tenure}</time>
                  <span class="entry-count">{String(exp.contributions.length).padStart(2, "0")} LOGS</span>
                </header>

                <ol class="contribution-list">
                  {exp.contributions.map((contribution, contributionIndex) => (
                    <li>
                      <span class="contribution-number">.{String(contributionIndex + 1).padStart(2, "0")}</span>
                      <h4>{contribution.title}</h4>
                      <dl>
                        <div><dt>WHY</dt><dd>{contribution.why}</dd></div>
                        <div><dt>WHAT</dt><dd>{contribution.what}</dd></div>
                        <div><dt>HOW</dt><dd>{contribution.how}</dd></div>
                      </dl>
                    </li>
                  ))}
                </ol>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="workspace-section">
      <div class="container mx-auto workspace-grid">
        <div class="workspace-label"><span>03 / ENVIRONMENT</span><p>SHUTTER OPEN<br />SYSTEM ACTIVE</p></div>
        <figure>
          <img src="/img/bg_9.webp" alt="Workspace" loading="lazy" />
          <figcaption><span>FIG.03 / WORKSPACE</span><span>OBSERVATION DECK</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="achievement-section">
      <div class="container mx-auto achievement-grid">
        <header>
          <div><span class="section-index">04</span><span class="section-label">ACHIEVEMENTS</span></div>
          <h2>A few things I'm<br /><i>proud of.</i></h2>
        </header>
        <ol>
          {achievements.map((achievement, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><p>{achievement.title}</p><time>{achievement.year}</time></li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <ContactSection />
</BaseLayout>

<style>
  :global(.about-field-manual footer.mt-16) { margin-top: 0; }
  .about-hero { padding-top: 1.25rem; }
  .status-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .7rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .62rem/1 var(--font-mono); letter-spacing: .12em; }
  .status-line span:nth-child(2) { color: var(--color-app-accent); }
  .status-line span:last-child { text-align: right; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(17rem, .55fr); min-height: 700px; border-inline: 1px solid var(--color-app-ink-line); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 4.5rem clamp(1.25rem, 4vw, 4rem); border-right: 1px solid var(--color-app-ink-line); }
  .eyebrow, .section-label { color: var(--color-app-accent); font: .66rem/1 var(--font-mono); letter-spacing: .17em; text-transform: uppercase; }
  .eyebrow::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  h1 { margin: 1.75rem 0 3.5rem; font: 750 clamp(4.5rem, 10vw, 9.5rem)/.75 var(--font-display); letter-spacing: -.065em; }
  h1 > span { display: block; }
  h1 .shift { padding-left: clamp(0rem, 5vw, 5rem); }
  h1 i, .intro-statement h2 i, .section-heading h2 i, .achievement-section h2 i { color: var(--color-app-accent); font-family: var(--font-serif); font-weight: 400; }
  .intro-statement { display: grid; grid-template-columns: 5rem minmax(0, 38rem); gap: 1.5rem; margin-left: auto; }
  .intro-statement > span { padding-top: .45rem; border-top: 1px solid var(--color-app-accent); color: var(--color-app-accent); font: .6rem/1.2 var(--font-mono); }
  .intro-statement h2 { margin-bottom: 1.25rem; font: 560 clamp(1.5rem, 2.5vw, 2.5rem)/1.08 var(--font-display); letter-spacing: -.04em; }
  .intro-statement p { margin-top: .8rem; color: var(--color-app-gray-500); font-size: .9rem; line-height: 1.6; }
  .portrait { display: flex; flex-direction: column; justify-content: flex-end; padding: 1rem; }
  .portrait-frame { position: relative; aspect-ratio: 3 / 4.4; overflow: hidden; background: var(--color-app-surface); clip-path: polygon(0 0, 88% 0, 100% 9%, 100% 100%, 0 100%); }
  .portrait-frame::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--color-app-body) 80%, transparent)); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); }
  .scan-line { position: absolute; z-index: 2; top: 31%; inset-inline: 0; height: 1px; background: var(--color-app-accent); }
  .portrait-id { position: absolute; z-index: 3; top: 1rem; left: 1rem; color: var(--color-app-accent); font: .62rem/1 var(--font-mono); }
  .portrait figcaption { display: flex; justify-content: space-between; margin-top: .7rem; color: var(--color-app-gray-400); font: .57rem/1 var(--font-mono); letter-spacing: .1em; }
  .education-ledger { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--color-app-ink-line); }
  .education-ledger > div { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1rem; border-right: 1px solid var(--color-app-ink-line); }
  .education-ledger > div:last-child { border-right: 0; }
  .education-ledger dt { color: var(--color-app-gray-400); font: .58rem/1.3 var(--font-mono); letter-spacing: .1em; }
  .education-ledger dd { text-align: right; font: 550 .86rem/1 var(--font-display); }
  .history-section, .achievement-section { padding: clamp(5rem, 10vw, 9rem) 0; }
  .section-heading { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 2rem; align-items: start; margin-bottom: 4rem; }
  .section-heading > div, .achievement-section header > div { display: flex; gap: 1rem; align-items: center; }
  .section-index { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .68rem/1 var(--font-mono); }
  .section-heading h2, .achievement-section h2 { font: 650 clamp(2.8rem, 5.8vw, 6rem)/.88 var(--font-display); letter-spacing: -.055em; }
  .section-heading > p { color: var(--color-app-gray-400); font: .62rem/1.7 var(--font-mono); letter-spacing: .1em; }
  .experience-ledger { border-top: 2px solid var(--color-app-text); }
  .experience-ledger > li { border-bottom: 1px solid var(--color-app-ink-line); }
  .role-heading { display: grid; grid-template-columns: 3rem 1.4fr .7fr .35fr; gap: 1.5rem; align-items: center; padding: 2rem .5rem; }
  .role-number, .entry-count, .role-heading time { color: var(--color-app-gray-400); font: .6rem/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .role-number { align-self: start; color: var(--color-app-accent); }
  .role-identity { display: flex; align-items: center; gap: 1rem; }
  .role-identity img { width: 3rem; height: 3rem; padding: .4rem; border: 1px solid var(--color-app-border); object-fit: contain; background: var(--color-app-surface); }
  .role-identity h3 { font: 620 clamp(1.6rem, 3vw, 3rem)/.95 var(--font-display); letter-spacing: -.045em; }
  .role-identity h3 span { color: var(--color-app-accent); font: .7rem/1 var(--font-mono); }
  .role-identity p { margin-top: .35rem; color: var(--color-app-accent); font: italic 1rem/1.2 var(--font-serif); }
  .contribution-list { border-top: 1px solid var(--color-app-border); }
  .contribution-list > li { display: grid; grid-template-columns: 3rem .75fr 1.5fr; gap: 1.5rem; padding: 1.6rem .5rem; border-bottom: 1px solid var(--color-app-border); }
  .contribution-list > li:last-child { border-bottom: 0; }
  .contribution-number { color: var(--color-app-accent); font: .6rem/1 var(--font-mono); }
  .contribution-list h4 { font: 560 clamp(1rem, 1.7vw, 1.35rem)/1.15 var(--font-display); letter-spacing: -.025em; }
  .contribution-list dl > div { display: grid; grid-template-columns: 3.5rem 1fr; gap: .75rem; margin-bottom: .65rem; }
  .contribution-list dt { color: var(--color-app-gray-400); font: .55rem/1.5 var(--font-mono); letter-spacing: .1em; }
  .contribution-list dd { color: var(--color-app-gray-500); font-size: .78rem; line-height: 1.55; }
  .workspace-section { padding: 5rem 0; color: var(--color-app-inverse-text); background: var(--color-app-inverse); }
  .workspace-grid { display: grid; grid-template-columns: .35fr 1.65fr; gap: 2rem; }
  .workspace-label { display: flex; flex-direction: column; justify-content: space-between; padding-top: .5rem; border-top: 2px solid var(--color-app-inverse-text); font: .6rem/1.5 var(--font-mono); letter-spacing: .1em; }
  .workspace-label span { color: var(--color-app-inverse-accent); }
  .workspace-section figure { border: 1px solid var(--color-app-inverse-line); }
  .workspace-section img { width: 100%; aspect-ratio: 2.59; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .workspace-section figcaption { display: flex; justify-content: space-between; padding: .65rem .8rem; border-top: 1px solid var(--color-app-inverse-line); color: var(--color-app-inverse-muted); font: .55rem/1 var(--font-mono); letter-spacing: .1em; }
  .achievement-grid { display: grid; grid-template-columns: .8fr 1.4fr; gap: clamp(3rem, 9vw, 9rem); }
  .achievement-section h2 { margin-top: 3rem; }
  .achievement-section ol { border-top: 2px solid var(--color-app-text); }
  .achievement-section li { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; padding: 1.5rem .25rem; border-bottom: 1px solid var(--color-app-border); }
  .achievement-section li span, .achievement-section time { color: var(--color-app-gray-400); font: .6rem/1.3 var(--font-mono); }
  .achievement-section li span { color: var(--color-app-accent); }
  .achievement-section li p { font: 520 clamp(1rem, 1.8vw, 1.4rem)/1.2 var(--font-display); }
  .reveal { opacity: 0; animation: reveal .75s cubic-bezier(.16,1,.3,1) forwards; animation-delay: calc(var(--delay) * 90ms + 100ms); }
  @keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .portrait { width: min(100%, 32rem); margin: auto; }
    .section-heading { grid-template-columns: 1fr 2fr; }
    .section-heading > p { grid-column: 2; }
    .role-heading { grid-template-columns: 2.5rem 1fr auto; }
    .entry-count { grid-column: 2; }
    .contribution-list > li { grid-template-columns: 2.5rem 1fr; }
    .contribution-list dl { grid-column: 2; }
    .achievement-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .status-line { grid-template-columns: 1fr auto; }
    .status-line span:last-child { display: none; }
    .hero-grid { min-height: auto; }
    .hero-copy { padding: 3.5rem 1rem; }
    h1 { font-size: clamp(3.7rem, 19vw, 6rem); }
    h1 .shift { padding-left: 0; }
    .intro-statement { grid-template-columns: 1fr; margin: 0; }
    .intro-statement > span { width: 5rem; }
    .education-ledger { grid-template-columns: 1fr; }
    .education-ledger > div { border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .education-ledger > div:last-child { border-bottom: 0; }
    .section-heading { display: flex; flex-direction: column; }
    .role-heading { grid-template-columns: 2rem 1fr; gap: 1rem; }
    .role-heading time, .entry-count { grid-column: 2; }
    .contribution-list > li { grid-template-columns: 2rem 1fr; gap: 1rem; }
    .contribution-list dl > div { grid-template-columns: 1fr; gap: .2rem; }
    .workspace-grid { grid-template-columns: 1fr; }
    .workspace-label { min-height: 5rem; }
    .workspace-section img { aspect-ratio: 1.5; }
  }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; animation: none; } }
</style>
