---
import BaseLayout from "../../components/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("diary")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const entriesByYear = entries.reduce((acc, entry) => {
  const year = entry.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(entry);
  return acc;
}, {} as Record<number, typeof entries>);

const years = Object.keys(entriesByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Diary - Dipankar Das"
  description="Monthly engineering diary entries tracking learnings and activities."
  bodyClass="diary-archive"
>
  <header class="diary-hero">
    <div class="container mx-auto">
      <div class="status-line">
        <span>OPERATOR LOG / MONTHLY</span><span>FILE: DYR-011</span><span>ARCHIVE / {years[years.length - 1]}—{years[0]}</span>
      </div>
      <div class="hero-grid">
        <div class="hero-title">
          <p>Chronological system record</p>
          <h1>MONTHLY<br /><i>LOG.</i></h1>
        </div>
        <aside>
          <span>01 / SCOPE</span>
          <p>What I built. What broke. What I learned. A low-polish record of the work between milestones.</p>
          <dl>
            <div><dt>Entries</dt><dd>{String(entries.length).padStart(2, "0")}</dd></div>
            <div><dt>Years tracked</dt><dd>{String(years.length).padStart(2, "0")}</dd></div>
            <div><dt>Frequency</dt><dd>Monthly</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </header>

  <section class="ledger" aria-labelledby="ledger-heading">
    <div class="container mx-auto">
      <header class="ledger-head">
        <div><span>02</span><p>CHRONOLOGICAL LEDGER</p></div>
        <h2 id="ledger-heading">Unfiltered<br /><i>operations.</i></h2>
        <p>Newest first.<br />One record per month.</p>
      </header>

      <div class="year-ledgers">
        {years.map((year, yearIndex) => (
          <section class="year-block" aria-labelledby={`year-${year}`}>
            <header>
              <span>YR / {String(yearIndex + 1).padStart(2, "0")}</span>
              <h3 id={`year-${year}`}>{year}</h3>
              <p>{String(entriesByYear[Number(year)].length).padStart(2, "0")} FILES</p>
            </header>
            <ol>
              {entriesByYear[Number(year)].map((entry, index) => {
                const month = entry.data.date.toLocaleDateString("en-US", { month: "long" });
                return (
                  <li>
                    <a href={`/diary/${entry.id}/`}>
                      <span class="entry-index">{String(index + 1).padStart(2, "0")}</span>
                      <time datetime={entry.data.date.toISOString()}>{month}</time>
                      <div>
                        <h4>{entry.data.title}</h4>
                        {entry.data.description && <p>{entry.data.description}</p>}
                      </div>
                      <span class="arrow">→</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.diary-archive footer.mt-16) { margin-top: 0; }
  .diary-hero { padding-top: 1.25rem; }
  .status-line { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding: .7rem .85rem; border: 1px solid var(--color-app-ink-line); color: var(--color-app-gray-400); font: .6rem/1 var(--font-mono); letter-spacing: .12em; }
  .status-line span:first-child { color: var(--color-app-text); }
  .status-line span:last-child { color: var(--color-app-accent); text-align: right; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(18rem, .55fr); min-height: 38rem; border-inline: 1px solid var(--color-app-ink-line); border-bottom: 1px solid var(--color-app-ink-line); }
  .hero-title { display: flex; flex-direction: column; justify-content: center; padding: clamp(3rem, 7vw, 7rem) clamp(1rem, 4vw, 4rem); border-right: 1px solid var(--color-app-ink-line); overflow: hidden; }
  .hero-title > p { color: var(--color-app-accent); font: .65rem/1 var(--font-mono); letter-spacing: .17em; text-transform: uppercase; }
  .hero-title > p::before { content: ""; display: inline-block; width: 2.5rem; height: 1px; margin-right: .7rem; vertical-align: middle; background: currentColor; }
  h1 { margin-top: 2.2rem; font: 750 clamp(5rem, 12vw, 11rem)/.7 var(--font-display); letter-spacing: -.07em; }
  h1 i, .ledger-head i { color: var(--color-app-accent); font-family: var(--font-serif); font-weight: 400; }
  .hero-grid aside { display: flex; flex-direction: column; justify-content: flex-end; padding: 1.25rem; background: var(--color-app-surface); }
  .hero-grid aside > span { margin-bottom: auto; color: var(--color-app-accent); font: .6rem/1 var(--font-mono); letter-spacing: .12em; }
  .hero-grid aside > p { color: var(--color-app-gray-500); font-size: 1rem; line-height: 1.6; }
  .hero-grid dl { margin-top: 2.5rem; border-top: 1px solid var(--color-app-ink-line); }
  .hero-grid dl div { display: flex; justify-content: space-between; padding: .8rem 0; border-bottom: 1px solid var(--color-app-border); font: .58rem/1.2 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .hero-grid dt { color: var(--color-app-gray-400); }
  .ledger { padding: clamp(5rem, 10vw, 9rem) 0; }
  .ledger-head { display: grid; grid-template-columns: .65fr 1.5fr .6fr; gap: 2rem; align-items: start; margin-bottom: 5rem; }
  .ledger-head > div { display: flex; align-items: center; gap: 1rem; }
  .ledger-head > div span { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--color-app-accent-ink); background: var(--color-app-accent); font: .65rem/1 var(--font-mono); }
  .ledger-head > div p { color: var(--color-app-accent); font: .62rem/1.3 var(--font-mono); letter-spacing: .12em; }
  .ledger-head h2 { font: 680 clamp(3rem, 6vw, 6rem)/.85 var(--font-display); letter-spacing: -.06em; }
  .ledger-head > p { color: var(--color-app-gray-400); font-size: .8rem; line-height: 1.55; }
  .year-ledgers { border-top: 2px solid var(--color-app-text); }
  .year-block { display: grid; grid-template-columns: minmax(10rem, .42fr) 1.58fr; border-bottom: 1px solid var(--color-app-ink-line); }
  .year-block > header { position: relative; padding: 2rem 2rem 2rem .5rem; border-right: 1px solid var(--color-app-ink-line); }
  .year-block > header span, .year-block > header p { color: var(--color-app-gray-400); font: .58rem/1 var(--font-mono); letter-spacing: .1em; }
  .year-block > header h3 { margin: 2rem 0 .8rem; font: 700 clamp(4rem, 8vw, 8rem)/.75 var(--font-display); letter-spacing: -.07em; writing-mode: vertical-rl; transform: rotate(180deg); }
  .year-block ol { min-width: 0; }
  .year-block li a { display: grid; grid-template-columns: 3rem 8rem minmax(0, 1fr) auto; gap: 1.25rem; align-items: start; min-height: 8rem; padding: 1.75rem 1rem; border-bottom: 1px solid var(--color-app-border); transition: background .2s, padding .2s; }
  .year-block li:last-child a { border-bottom: 0; }
  .year-block li a:hover, .year-block li a:focus-visible { padding-inline: 1.5rem; background: var(--color-app-surface); }
  .entry-index, .year-block time { padding-top: .25rem; color: var(--color-app-gray-400); font: .6rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .entry-index { color: var(--color-app-accent); }
  .year-block h4 { font: 620 clamp(1.4rem, 2.6vw, 2.6rem)/1 var(--font-display); letter-spacing: -.04em; transition: color .2s; }
  .year-block a:hover h4 { color: var(--color-app-accent); }
  .year-block li p { display: -webkit-box; overflow: hidden; max-width: 48rem; margin-top: .65rem; color: var(--color-app-gray-400); font-size: .78rem; line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .arrow { color: var(--color-app-accent); transition: transform .2s; }
  .year-block a:hover .arrow { transform: translateX(.25rem); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-title { min-height: 28rem; border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .hero-grid aside { min-height: 20rem; }
    .ledger-head { grid-template-columns: .7fr 1.4fr; }
    .ledger-head > p { grid-column: 2; }
    .year-block { grid-template-columns: 9rem 1fr; }
    .year-block li a { grid-template-columns: 2.5rem 6rem minmax(0, 1fr) auto; }
  }
  @media (max-width: 640px) {
    .status-line { grid-template-columns: 1fr auto; }
    .status-line span:nth-child(2) { display: none; }
    .hero-title { min-height: 23rem; }
    h1 { font-size: clamp(4.2rem, 23vw, 7rem); }
    .ledger-head { display: flex; flex-direction: column; }
    .year-block { display: block; }
    .year-block > header { display: flex; align-items: baseline; gap: 1rem; padding: 2rem .5rem; border-right: 0; border-bottom: 1px solid var(--color-app-ink-line); }
    .year-block > header h3 { order: -1; margin: 0; font-size: 4rem; writing-mode: initial; transform: none; }
    .year-block li a { grid-template-columns: 2.5rem 1fr auto; gap: .75rem; }
    .year-block time { grid-column: 2; grid-row: 1; }
    .year-block li a > div { grid-column: 2; }
    .arrow { grid-column: 3; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .year-block li a, .arrow { transition: none; } }
</style>
